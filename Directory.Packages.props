<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Windows P/Invoke (source generator) -->
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.367" />
    <!-- DXGI / Direct3D11 -->
    <PackageVersion Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageVersion Include="Vortice.DXGI" Version="3.8.3" />
    <!-- Image processing -->
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <!-- Input hooks (cross-platform) -->
    <PackageVersion Include="SharpHook" Version="8.0.1" />
    <!-- DI -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <!-- SourceLink -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
    <!-- Benchmarking -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- UI Automation -->
    <!-- FlaUI.Core: transitive pin to ensure version consistency with FlaUI.UIA3 -->
    <PackageVersion Include="FlaUI.UIA3" Version="5.0.0" />
    <!-- System.Drawing.Common: pin to safe version (FlaUI transitive dep, CVE in < 8.0.10) -->
    <!-- Office -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- MCP -->
    <PackageVersion Include="ModelContextProtocol" Version="2.3.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <!-- AI Integration (demo) -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageVersion Include="OpenAI" Version="2.14.0" />
    <!-- Testing (xUnit v3 / Microsoft.Testing.Platform) -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.1" />
    <PackageVersion Include="ChildProcessGuard" Version="1.4.0" />
    <PackageVersion Include="Iyu.Conventions.Testing" Version="0.13.0" />
  </ItemGroup>
</Project>