<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Windows P/Invoke (source generator) -->
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.275" />
    <!-- DXGI / Direct3D11 -->
    <PackageVersion Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageVersion Include="Vortice.DXGI" Version="3.8.3" />
    <!-- Image processing -->
    <PackageVersion Include="SkiaSharp" Version="4.151.1" />
    <!-- Input hooks (cross-platform) -->
    <PackageVersion Include="SharpHook" Version="8.0.0" />
    <!-- DI -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <!-- SourceLink -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.300" />
    <!-- Benchmarking -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.14.0" />
    <!-- UI Automation -->
    <!-- FlaUI.Core: transitive pin to ensure version consistency with FlaUI.UIA3 -->
    <PackageVersion Include="FlaUI.Core" Version="5.0.0" />
    <PackageVersion Include="FlaUI.UIA3" Version="5.0.0" />
    <!-- System.Drawing.Common: pin to safe version (FlaUI transitive dep, CVE in < 8.0.10) -->
    <PackageVersion Include="System.Drawing.Common" Version="10.0.11" />
    <!-- Browser -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.59.0" />
    <!-- Email -->
    <PackageVersion Include="MailKit" Version="4.16.0" />
    <!-- Office -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- MCP -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <!-- AI Integration (demo) -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <PackageVersion Include="OpenAI" Version="2.12.0" />
    <!-- Testing (xUnit v3 / Microsoft.Testing.Platform — BD-20260829-xunit-v3-pilot rollout) -->
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.3.3" />
    <PackageVersion Include="ChildProcessGuard" Version="1.1.1" />
  </ItemGroup>
</Project>