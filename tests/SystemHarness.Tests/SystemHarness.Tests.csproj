<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>SystemHarness.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 test projects are stand-alone executables (BD-20260829-xunit-v3-pilot) -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SystemHarness.Core\SystemHarness.Core.csproj" />
    <ProjectReference Include="..\..\src\SystemHarness.Windows\SystemHarness.Windows.csproj" />
    <ProjectReference Include="..\..\src\SystemHarness.Apps.Office\SystemHarness.Apps.Office.csproj" />
    <ProjectReference Include="..\..\src\SystemHarness.Mcp\SystemHarness.Mcp.csproj" />
    <ProjectReference Include="..\..\src\SystemHarness.Apps.Browser\SystemHarness.Apps.Browser.csproj" />
    <ProjectReference Include="..\..\src\SystemHarness.Apps.Email\SystemHarness.Apps.Email.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="ChildProcessGuard" />
    <PackageReference Include="Iyu.Conventions.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
